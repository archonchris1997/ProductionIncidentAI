{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "AI": {
    "Provider": "Scripted",
    "Model": "scripted-v1",
    "Temperature": 0,
    "OpenAI": {
      "Endpoint": "",
      "ApiKey": ""
    }
  },

  "Mcp": {
    "Mode": "Local",
    "Servers": [
      { "Name": "local-all", "Endpoint": "http://localhost:5103/mcp" }
    ]
  },

  "Harness": {
    "MaxInvestigationRounds": 3,
    "MaxHandoffsPerRound": 3,
    "ConfidenceThreshold": 0.85,
    "MaxAgentIterations": 8,
    "LlmCallTimeout": "00:01:30",
    "ToolCallTimeout": "00:00:30",
    "MaxRetries": 2,
    "MaxToolResultChars": 6000,
    "KeepRecentToolResults": 3,
    "MaxTokensPerIncident": 500000,
    "MaxCostPerIncidentUsd": 5.0,
    "AutoApprovedTools": []
  },

  "LlmOps": {
    "InputPricePerMillionTokens": 2.5,
    "OutputPricePerMillionTokens": 10.0,
    "ReleaseGate": {
      "MinRootCauseAccuracy": 1.0,
      "MinEvidenceCoverage": 0.8,
      "MinToolRecall": 0.8,
      "MinCalibration": 0.75,
      "MinJudgeScore": 0.7,
      "MaxForbiddenClaimViolations": 0,
      "MaxAverageCostUsd": 1.0
    }
  },

  "Persistence": {
    "Provider": "InMemory",
    "Directory": "data/investigations"
  },

  "Worker": {
    "MaxConcurrentInvestigations": 4,
    "ResumeOnStartup": true
  }
}
